{
  "name": "pixiwechattest",
  "version": "1.0.0",
  "description": "TypeScript、Three.js 与 PixiJS 微信小游戏框架",
  "main": "game.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run bundle -- --define:MODEL_DEMO=false",
    "build:model": "npm run typecheck && npm run bundle -- --define:MODEL_DEMO=true",
    "bundle": "esbuild src/main.ts --bundle --minify --platform=browser --format=iife --target=es2019 --define:performance=globalThis.performance --external:fs --external:path --outfile=dist/game.bundle.js",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "pixi.js": "^8.23.0",
    "three-platformize": "^1.133.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "minigame-api-typings": "^3.8.22",
    "typescript": "^5.9.3"
  }
}
