{
  "name": "pixiwechattest",
  "version": "1.0.0",
  "description": "TypeScript、Three.js 与 PixiJS 微信小游戏框架",
  "main": "game.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.cjs controls",
    "build:model": "node scripts/build.cjs model-viewer",
    "build:app": "node scripts/build.cjs showcase",
    "build:app:model": "node scripts/build.cjs showcase-model",
    "build:webgl2": "node scripts/build.cjs webgl2",
    "build:webgl2:model": "node scripts/build.cjs webgl2-model",
    "build:ui": "node scripts/build.cjs pixi-ui",
    "build:workbench": "node scripts/build.cjs workbench",
    "build:color-match": "node scripts/build.cjs color-match",
    "build:target": "node scripts/build.cjs",
    "build:list": "node scripts/build.cjs --list",
    "test": "node --test tests/*.test.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "pixi.js": "^8.23.0",
    "three-platformize": "^1.133.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "minigame-api-typings": "^3.8.22",
    "typescript": "^5.9.3"
  }
}
